{
  "name": "365-daynight-vscode-theme-ext",
  "displayName": "365 Day & Night Themes",
  "description": "36 accessible VS Code color themes: a Light, Dark and High Contrast theme for every month of the year, with one-click and optional automatic day/night switching. WCAG AA/AAA contrast, color-blind friendly.",
  "version": "0.11.1",
  "publisher": "mickaellherminez",
  "type": "commonjs",
  "icon": "assets/logo-web.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext.git"
  },
  "homepage": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext#readme",
  "bugs": {
    "url": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext/issues"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "light theme",
    "high contrast",
    "dark mode",
    "light mode",
    "day night",
    "auto theme",
    "automatic theme switcher",
    "accessibility",
    "accessible",
    "a11y",
    "wcag",
    "color blind",
    "colorblind",
    "protanopia",
    "deuteranopia",
    "tritanopia",
    "low vision",
    "eye strain",
    "readable",
    "seasonal themes",
    "monthly themes",
    "spring",
    "summer",
    "autumn",
    "winter",
    "status bar",
    "theme toggle"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.toggleTheme",
        "title": "Toggle between Light, Dark and High Contrast themes",
        "category": "365"
      },
      {
        "command": "extension.setLightTheme",
        "title": "Apply Light theme",
        "category": "365"
      },
      {
        "command": "extension.setDarkTheme",
        "title": "Apply Dark theme",
        "category": "365"
      },
      {
        "command": "extension.setHighContrastTheme",
        "title": "Apply High Contrast theme",
        "category": "365"
      }
    ],
    "configuration": {
      "title": "365 Day & Night Themes",
      "properties": {
        "365DayNight.enable": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply the 365 theme matching the current month (and time of day in `auto` mode)."
        },
        "365DayNight.mode": {
          "type": "string",
          "enum": [
            "auto",
            "day",
            "night"
          ],
          "enumDescriptions": [
            "Light theme from 7:00 to 19:00, Dark theme otherwise.",
            "Always use the Light theme of the current month.",
            "Always use the Dark theme of the current month."
          ],
          "default": "auto",
          "description": "Theme selection mode used when `365DayNight.enable` is on."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "365themes.themeSelector",
          "group": "9_cutcopypaste"
        }
      ],
      "365themes.themeSelector": [
        {
          "command": "extension.setLightTheme",
          "group": "1_themes"
        },
        {
          "command": "extension.setDarkTheme",
          "group": "1_themes"
        },
        {
          "command": "extension.setHighContrastTheme",
          "group": "1_themes"
        },
        {
          "command": "extension.toggleTheme",
          "group": "2_toggle"
        }
      ],
      "view/title": [
        {
          "submenu": "365themes.themeSelector",
          "group": "appearance"
        }
      ],
      "menuBar/appearance": [
        {
          "submenu": "365themes.themeSelector",
          "group": "1_themes"
        }
      ]
    },
    "submenus": [
      {
        "id": "365themes.themeSelector",
        "label": "365 Themes"
      }
    ],
    "themes": [
      {
        "label": "365 01-January Light",
        "uiTheme": "vs",
        "path": "./themes/365-01-light-theme.json"
      },
      {
        "label": "365 01-January High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/365-01-hc-dark-theme.json"
      },
