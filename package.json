  "scripts": {
    "lint": "eslint --config eslint.config.cjs .",
    "pretest": "npm run lint && npm run test:unit",
    "test": "node ./test/runTest.cjs",
    "test:unit": "mocha --ui tdd \"test/unit/**/*.test.cjs\"",
    "site:build": "node scripts/site/build.cjs",
    "site:check": "node scripts/site/check.cjs",
    "site:preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory site-dist",
    "package": "vsce package",
    "vscode:prepublish": "npm run lint",
    "publish": "NODE_NO_WARNINGS=1 vsce publish",
    "themes:audit": "python3 scripts/themes/audit.py",
    "themes:build": "python3 scripts/themes/build.py",
    "themes:check": "python3 scripts/themes/build.py --check",
    "themes:test": "python3 -m unittest discover -s scripts/themes/tests",
    "themes:variety": "python3 scripts/themes/variety.py",
