{
  "name": "365-daynight-vscode-theme-ext",
  "displayName": "365 Day & Night – Monthly Accessible Themes",
  "description": "Accessible light, dark and high contrast themes for every month of the year, 48 in all. Switch between day and night in one click or automatically. WCAG AA/AAA contrast, checked for color blindness.",
  "version": "1.0.0",
  "publisher": "mickaellherminez",
  "type": "commonjs",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext.git"
  },
  "homepage": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext#readme",
  "bugs": {
    "url": "https://github.com/mickaellherminez/365-daynight-vscode-theme-ext/issues"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "light theme",
    "high contrast",
    "dark mode",
    "light mode",
    "day night",
    "auto theme",
    "automatic theme switcher",
    "accessibility",
    "accessible",
    "a11y",
    "wcag",
    "color blind",
    "colorblind",
    "protanopia",
    "deuteranopia",
    "tritanopia",
    "low vision",
    "eye strain",
    "readable",
    "seasonal themes",
    "monthly themes",
    "spring",
    "summer",
    "autumn",
    "winter",
    "status bar",
    "theme toggle"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.toggleTheme",
        "title": "Toggle between Light and Dark themes",
        "category": "365"
      },
      {
        "command": "extension.setLightTheme",
        "title": "Apply Light theme",
        "category": "365"
      },
      {
        "command": "extension.setDarkTheme",
        "title": "Apply Dark theme",
        "category": "365"
      },
      {
        "command": "extension.setHighContrastTheme",
        "title": "Apply High Contrast theme",
        "category": "365"
      },
      {
        "command": "extension.setHighContrastLightTheme",
        "title": "Apply High Contrast Light theme",
        "category": "365"
      },
      {
        "command": "extension.nextMonth",
        "title": "Next month",
        "category": "365"
      },
      {
        "command": "extension.previousMonth",
        "title": "Previous month",
        "category": "365"
      },
      {
        "command": "extension.currentMonth",
        "title": "Back to the current month",
        "category": "365"
      }
    ],
    "colors": [
      {
        "id": "365DayNight.statusBarButton",
        "description": "Color of the 365 Day & Night status bar button: the month arrows, the month and the variant.",
        "defaults": {
          "dark": "statusBar.foreground",
          "light": "statusBar.foreground",
          "highContrast": "statusBar.foreground",
          "highContrastLight": "statusBar.foreground"
        }
      }
    ],
    "configuration": {
      "title": "365 Day & Night Themes",
      "properties": {
        "365DayNight.enable": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply the 365 theme matching the current month (and time of day in `auto` mode)."
        },
        "365DayNight.mode": {
          "type": "string",
          "enum": [
            "auto",
            "day",
            "night",
            "system"
          ],
          "enumDescriptions": [
            "Light theme from Day Start to Night Start (7:00 to 19:00 by default), Dark theme otherwise.",
            "Always use the Light theme of the current month.",
            "Always use the Dark theme of the current month.",
            "Follow the light, dark and high contrast appearance of your system, with the themes of the current month. Your system decides the variant; the arrows still change the month."
          ],
          "default": "auto",
          "description": "Theme selection mode used when `365DayNight.enable` is on."
        },
        "365DayNight.dayStart": {
          "type": "string",
          "default": "07:00",
          "pattern": "^([01]?[0-9]|2[0-3]):([0-5][0-9])$",
          "patternErrorMessage": "Use the HH:MM format on a 24-hour clock, for example 07:00.",
          "markdownDescription": "Time when the Light theme starts, in the HH:MM format on a 24-hour clock. Used when `#365DayNight.mode#` is `auto`."
        },
        "365DayNight.nightStart": {
          "type": "string",
          "default": "19:00",
          "pattern": "^([01]?[0-9]|2[0-3]):([0-5][0-9])$",
          "patternErrorMessage": "Use the HH:MM format on a 24-hour clock, for example 19:00.",
          "markdownDescription": "Time when the Dark theme starts, in the HH:MM format on a 24-hour clock. Used when `#365DayNight.mode#` is `auto`. If it is earlier than `#365DayNight.dayStart#`, the Light theme runs past midnight."
        },
        "365DayNight.toggleIncludesHighContrast": {
          "type": "boolean",
          "default": false,
          "description": "Also include the High Contrast variants when switching with the status bar button: Light, Dark, High Contrast, then High Contrast Light."
        }
      }
    },
    "themes": [
      {
